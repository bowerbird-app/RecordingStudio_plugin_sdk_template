{
  "name": "recording-studio-plugin-sdk",
  "version": "0.3.0",
  "private": true,
  "description": "Browser plugin SDK for the Recording Studio WordPress plugin feature",
  "type": "module",
  "scripts": {
    "sync:tokens": "node scripts/sync-flatpack-tokens.mjs",
    "build": "npm run sync:tokens && node scripts/build.mjs",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "check:version": "node scripts/check-version.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "lint": "npm run check:version && npm run check:dist"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.0",
    "linkedom": "^0.18.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
