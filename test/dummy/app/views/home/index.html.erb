<% dummy_page_nav(title: "Plugin SDK", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Plugin SDK",
    subtitle: "This dummy app is the proof host for the browser plugin SDK.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "What's working",
          subtitle: "Host chrome the dummy app already proves.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li>Devise sign-in and Recording Studio default layout are wired.</li>
          <li>Workspace, Folder, and Page recordables seed a small tree.</li>
          <li>Tailwind and FlatPack stay on the host. The SDK ships finished CSS under <code>.rs-widget</code>.</li>
          <li>This page is the proof host. It does not mount the gem engine.</li>
        </ul>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Next steps",
          subtitle: "What this host will prove once dist/ lands.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ol class="space-y-3 text-sm leading-6 list-decimal pl-5">
          <li>Load committed <code>dist/</code> JS and CSS on this page.</li>
          <li>Mount a schema_version 1 fixture under <code>.rs-widget</code>.</li>
          <li>Keep dummy docs for host wiring. Keep product docs in the root README.</li>
        </ol>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "FlatPack usage",
          subtitle: "Host chrome uses FlatPack. Widget CSS lives in the SDK bundle.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <p class="text-sm leading-6 text-(--surface-content-color)">
          Dummy pages stay on FlatPack ViewComponents. The browser SDK does not ship Ruby ViewComponents.
        </p>
      <% end %>

      <% card.footer do %>
        <a href="https://flatpack.bowerbird.io/"
           target="_blank"
           rel="noopener noreferrer"
           class="inline-flex">
          <%= render FlatPack::Button::Component.new(
            text: "View FlatPack documentation",
            style: :primary,
            size: :md
          ) %>
        </a>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Install flow",
          subtitle: "Rails hosts can still install the engine. WordPress copies dist/.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li>Add the gem to a Rails host and run <code>bundle install</code>.</li>
          <li>Run <code>rails generate recording_studio_plugin_sdk_template:install</code> if you need the engine mounted.</li>
          <li>WordPress adapters copy <code>dist/</code> into the plugin <code>build/sdk/</code> folder.</li>
          <li>Rebuild Tailwind if the host scans engine views: <code>bin/rails tailwindcss:build</code>.</li>
        </ul>
      <% end %>
    <% end %>
  </div>
</div>
